# ============================================================
# Exemplo de variáveis de ambiente — copie para `.env.local`
# (na Netlify: Site configuration → Environment variables)
# ============================================================

# Chaves do painel Supabase (Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Senha de acesso ao painel /admin (mínimo 4 caracteres)
ADMIN_PASSWORD=escolha-uma-senha-aqui

# As chaves JWT/URL também podem ser usadas pelo painel futuramente:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
